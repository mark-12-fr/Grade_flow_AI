# ---- Free AI (pick ONE provider) -------------------------------------------
# gemini      Google AI Studio free tier (recommended, big context): https://aistudio.google.com/apikey
# groq        Groq free tier:                                        https://console.groq.com/keys
# openrouter  OpenRouter ":free" models:                             https://openrouter.ai/keys
# ollama      Runs on your own computer, no key, no limits:          https://ollama.com
AI_PROVIDER=gemini
AI_API_KEY=
# Optional: override the model (defaults: gemini-2.5-flash, llama-3.3-70b-versatile, llama3.1)
AI_MODEL=

# ---- Protect your key and your quota (all optional, safe defaults shown) ----
# Require this code to use the AI import (set it when the server is reachable by other people)
APP_ACCESS_CODE=
# AI requests allowed per visitor (IP) per window, window in seconds
AI_RATE_LIMIT=6
AI_RATE_WINDOW=600
# Hard cap on AI calls per day for the whole server (0 = no cap)
AI_DAILY_CAP=60
# SF10: max sheets (one AI call each) and max size of one sheet
AI_MAX_SHEETS=8
AI_MAX_SHEET_CHARS=60000
# Set to 1 only behind a trusted reverse proxy (to read the real visitor IP)
TRUST_PROXY=0
