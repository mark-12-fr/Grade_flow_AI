# ---- Free AI (one or MANY providers) ---------------------------------------
# gemini      Google AI Studio free tier (recommended, big context): https://aistudio.google.com/apikey
# groq        Groq free tier:                                        https://console.groq.com/keys
# openrouter  OpenRouter ":free" models:                             https://openrouter.ai/keys
# ollama      Runs on your own computer, no key, no limits:          https://ollama.com
# Simple: one provider.
AI_PROVIDER=gemini
AI_API_KEY=
# More requests at once: add keys for other providers (and/or several keys, comma-separated).
# Any provider with a key is used as a backup when the main one hits its quota or is busy.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional: priority order (default: AI_PROVIDER first, then the rest that have a key)
AI_PROVIDERS=
# 1 = spread requests across all keys in turn instead of using the first until it runs out
AI_ROTATE=0
# Optional: override the model/base URL of the main provider (defaults: gemini-2.5-flash, llama-3.3-70b-versatile, llama3.1)
AI_MODEL=

# ---- Limits (all OFF by default; 0 = no limit). Turn them on to protect your quota or bill ----
# Require this code to use the AI import (set it when the server is reachable by other people)
APP_ACCESS_CODE=
# AI requests allowed per visitor per window (window in seconds)
AI_RATE_LIMIT=0
AI_RATE_WINDOW=600
# Hard cap on AI calls per day for the whole server
AI_DAILY_CAP=0
# SF10: max sheets per upload (one AI call each) and max size of one sheet in characters (60000 is about 20k tokens)
AI_MAX_SHEETS=0
AI_MAX_SHEET_CHARS=0
# Set to 1 only behind a trusted reverse proxy (to read the real visitor IP)
TRUST_PROXY=0
